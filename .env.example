APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
LIVE_APPROVAL_UI_ENABLED=false
DATABASE_URL=sqlite:///./data/quantlab.db
APP_SECRET_KEY=replace-with-a-long-random-local-secret
APPROVAL_TOKEN_SECRET=replace-with-a-different-long-random-local-secret
ETRADE_ENV=sandbox
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=
ETRADE_ACCESS_TOKEN=
ETRADE_ACCESS_TOKEN_SECRET=
ETRADE_ACCOUNT_ID_KEY=
# Deliberately fail closed. Use etrade only after configuring authorized OAuth tokens.
MARKET_DATA_PROVIDER=none
HISTORICAL_DATA_DIR=data/historical
BACKTEST_UPLOAD_MAX_BYTES=50000000
ETRADE_OAUTH_PENDING_TTL_SECONDS=600
QUOTE_STALE_SECONDS=120
PAPER_INITIAL_EQUITY=10000
PAPER_SLIPPAGE_BPS=15
PAPER_LATENCY_MS=250
PAPER_PARTIAL_FILL_RATE=0.0
PAPER_FEE_PER_CONTRACT=0.65
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:8000
